  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/eslint"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/eslint/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/",
    "access": "restricted"
  },
  "exports": {
    "./typescript": {
      "types": "./dist/typescript.d.mts",
      "import": "./dist/typescript.mjs"
    },
    "./astro": {
      "types": "./dist/astro.d.mts",
      "import": "./dist/astro.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.mts",
      "import": "./dist/vue.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit --strict",
    "build": "tsdown",
    "lint:fix": "eslint . --fix",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-better-tailwindcss": "^4.1.1",
    "eslint-plugin-format": "^1.3.1",
    "eslint-plugin-github": "^6.0.0"
  },
  "dependencies": {
    "lodash": "^4.17.23"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/lodash": "^4.17.23",
    "baseline-browser-mapping": "^2.9.19",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "husky": "^9.1.7",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3"
  }
