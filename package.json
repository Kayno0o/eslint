{
  "name": "@kaynooo/eslint",
  "type": "module",
  "version": "3.0.1",
  "author": "Kaynooo <https://git.kaynooo.fr/kaynooo>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/eslint"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/eslint/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/",
    "access": "restricted"
  },
  "exports": {
    "./typescript": {
      "types": "./dist/typescript.d.ts",
      "import": "./dist/typescript.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsgo --noEmit --strict",
    "test": "bun test",
    "build": "rm -rf ./dist && bun run scripts/build.ts && tsgo -p tsconfig.build.json",
    "lint:fix": "eslint . --fix",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "eslint": "^10.6.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint-plugin-better-tailwindcss": "^4.6.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-solid": "^0.14.5",
    "lodash.merge": "^4.6.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/lodash.merge": "^4.6.9",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "baseline-browser-mapping": "^2.10.42",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  }
}
