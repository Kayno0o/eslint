{
  "name": "@kaynooo/eslint",
  "type": "module",
  "version": "8.0.2",
  "author": "Kaynooo <contact@kaynooo.fr> (https://git.kaynooo.fr/kaynooo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/eslint"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/eslint/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "keslint": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsgo --noEmit --strict",
    "test": "bun test",
    "build": "rm -rf ./dist && bun run scripts/build.ts && tsgo -p tsconfig.build.json",
    "lint:fix": "bun ./dist/bin.js . --fix",
    "lint": "bun ./dist/bin.js ."
  },
  "peerDependencies": {
    "eslint": "^10.7.0"
  },
  "dependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-antfu": "^3.3.1",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-import-lite": "^0.6.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-regexp": "^3.3.2",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-yml": "^3.9.0",
    "globals": "^17.13.0",
    "toml-eslint-parser": "^1.0.3",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "baseline-browser-mapping": "^2.11.34",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  }
}
